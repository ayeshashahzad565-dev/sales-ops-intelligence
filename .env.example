# =============================================================================
# Sales & Revenue Operations Intelligence Pipeline - environment template
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored. Never commit real credentials.
# Every variable below is required - docker compose warns on any that is unset.
# =============================================================================

# --- General -----------------------------------------------------------------
# Applied to every container so timestamps agree across services.
TZ=Europe/London

# --- PostgreSQL --------------------------------------------------------------
# Credentials for the shared Postgres instance. This user owns all three
# databases: ${POSTGRES_DB}, n8n, and metabase.
#
# NOTE: these are only read when the data volume is first created. Changing
# them later has no effect until you run `docker compose down -v`.
POSTGRES_USER=salesops
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=salesops

# Host port for psql / DBeaver / pgAdmin. Change if 5432 is already in use
# by a local Postgres install. Containers always use `postgres:5432` internally.
POSTGRES_HOST_PORT=5432

# --- Mock Sales/Orders API ---------------------------------------------------
MOCK_API_HOST_PORT=8000

# Seed for the synthetic order generator. The same seed, history length and end
# date always produce the same dataset.
MOCK_API_SEED=20260101

# Days of history generated on first start.
MOCK_API_HISTORY_DAYS=90

# Last day of the generated history. Leave BLANK to anchor it to today, so a
# fresh environment always shows recent dates. Set an explicit YYYY-MM-DD to
# make the dataset reproducible across days (the test suite pins it this way).
#
# Only read when the order book is first created. Changing it later has no
# effect until the mock_api_data volume is removed.
MOCK_API_HISTORY_END_DATE=

# The day the demonstration incident lives on. Leave BLANK: bootstrap.sh picks a
# date inside the generated window, injects a price collapse and a refund spike
# into it so Stage 6 has something to grade `critical`, and then writes the date
# back here. It is persisted rather than recomputed because the order book keeps
# the incident where it was put, while "ten days ago" moves every midnight - and
# the investigation dashboard and the Stage 11 tests both read this value to
# find it. Delete the line to have the next bootstrap choose a fresh day.
SALESOPS_INCIDENT_DATE=

# The highest-scoring day the pipeline graded `major`. Also written by
# bootstrap.sh, but read back from the warehouse rather than chosen: which
# ordinary days clear the material-impact threshold depends on the generated
# series. The warehouse-backed test suites use it as the rung below the injected
# critical. Leave BLANK.
SALESOPS_MAJOR_DATE=

# --- Analytics service (Stage 5 anomaly detection) ---------------------------
# Host port only. Inside the Docker network the service is analytics-service:8000.
# Database credentials are reused from the POSTGRES_* block above.
ANALYTICS_API_HOST_PORT=8001

# --- Stage 7: LLM root-cause analysis ----------------------------------------
# Only read when an analysis is requested. Stage 5 detection and Stage 6
# decisions work with every one of these unset - the pipeline degrades to "no
# explanations", never to "no decisions".
#
# The provider speaks the OpenAI chat-completions dialect, so Groq, OpenAI and
# most local runtimes all work by changing LLM_PROVIDER (or LLM_BASE_URL) and
# LLM_MODEL. Nothing else in the code changes.
#
#   groq    https://api.groq.com/openai/v1     default model llama-3.3-70b-versatile
#   openai  https://api.openai.com/v1          default model gpt-4.1-mini
#   other   set LLM_BASE_URL explicitly
LLM_PROVIDER=groq

# Leave blank to take the provider's default above. Model line-ups move quickly -
# check the provider's current list rather than trusting a name that once worked.
#
# Note: not every model supports json_schema structured output. Groq's
# llama-3.3-70b-versatile does not, so LLM_JSON_MODE=schema falls back to
# json_object automatically. The prompt states the full output contract either
# way, so both modes work; the mode actually used is recorded on every result.
LLM_MODEL=

# PLACEHOLDER ONLY. Put the real key in .env, which is gitignored.
# It travels in an Authorization header and nowhere else: never into PostgreSQL,
# never into an n8n workflow, never into a log line or an error message.
LLM_API_KEY=replace-with-your-provider-api-key

# Override only for a provider not listed above, or a local runtime.
LLM_BASE_URL=

# Zero on purpose. The same evidence should produce closely consistent output;
# sampling variety buys nothing here and makes two runs harder to compare.
LLM_TEMPERATURE=0

LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000

# schema = ask the provider to enforce the response JSON Schema, falling back to
#          json_object if the model does not support it (support varies by model)
# object = skip the negotiation and only require valid JSON
# Either way the response is validated identically afterwards; this changes only
# how much was guaranteed before validation ran.
LLM_JSON_MODE=schema

# --- Stage 8: notification delivery & human review ---------------------------
# Only read when routing is requested. Stages 5-7 work with every one of these
# unset - no delivery channel means findings are not delivered, not that they
# stop being detected, decided or explained.

NOTIFICATION_PROVIDER=webhook

# Where notifications are POSTed as JSON. Works with Slack, Teams, Discord,
# PagerDuty, Zapier or any internal relay that accepts a webhook.
#
# TREAT THIS AS A CREDENTIAL. A Slack or Teams webhook URL is a bearer token in
# URL form: anyone holding it can post as the integration. It is never written
# to the database, an n8n workflow, a log line or an error message, and the ops
# endpoint reports only its host.
#
# For local development and validation, point it at the service's own in-memory
# sink so nothing is delivered to a real channel:
#   http://analytics-service:8000/dev/notification-sink
NOTIFICATION_WEBHOOK_URL=http://analytics-service:8000/dev/notification-sink

NOTIFICATION_TIMEOUT_SECONDS=15
NOTIFICATION_FROM=salesops-pipeline

# Comma-separated. One notification is delivered per recipient per anomaly, and
# the idempotency key includes the recipient, so adding one later does not
# re-notify everybody else.
NOTIFICATION_RECIPIENTS=revenue-ops@example.invalid

# --- Stage 9: human-approved remediation -------------------------------------
# Nothing to configure, and that absence is the honest answer rather than an
# omission.
#
# Stage 9 executes remediation through a provider, exactly as Stage 8 delivers
# through one. The difference is that Stage 8 has a real destination available -
# any webhook - while this project contains no ticketing system, case management
# system or operations platform for remediation to reach. So the only provider
# is `RecordingRemediationProvider`: it records the request, returns a
# deterministic result, and contacts nothing. Every attempt it writes carries
# external_side_effect = false, and the audit view reports that column rather
# than leaving a reader to infer it.
#
# A real provider would add its own credentials here, read by the service from
# its own environment - never from an n8n workflow, where a URL or token would
# end up in the execution history and the n8n database.
#
# What DOES need configuring is nothing at all, because the authorisation the
# stage depends on is a human being, and there is no environment variable for
# that. Approval happens through POST /reviews/{id}/approve, and the actor is
# whatever the caller says it is: there is no authentication on this service,
# which is a real limitation and is documented as one.

# --- n8n ---------------------------------------------------------------------
N8N_HOST_PORT=5678
N8N_HOST=localhost

# Base URL n8n embeds in generated webhook URLs. Must be reachable from
# whatever will call the webhook. Nothing in Stages 0-9 needs an inbound
# callback - remediation is approved through the analytics service's own REST
# API, not through a webhook back into n8n - so localhost is fine. It would need
# to become a public tunnel URL (ngrok, n8n tunnel) only if an external system
# were ever given a callback into a workflow.
N8N_WEBHOOK_URL=http://localhost:5678/

# Encrypts stored credentials at rest. Generate a real one and keep it stable -
# if it changes, every saved credential in n8n becomes unreadable.
#   PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
#   bash:       openssl rand -base64 32
N8N_ENCRYPTION_KEY=replace-with-a-generated-32-byte-key

# Image tag. Left floating for the first run; pin it to the exact version you
# get (`docker compose images n8n`) once the environment is working.
N8N_IMAGE_TAG=latest

# --- Metabase ----------------------------------------------------------------
METABASE_HOST_PORT=3000
METABASE_SITE_URL=http://localhost:3000

# Same pinning advice as N8N_IMAGE_TAG.
METABASE_IMAGE_TAG=latest

# --- Stage 10: operational reliability ---------------------------------------
# Nothing to configure here either, and for a better reason than Stage 9's.
#
# Every Stage 10 threshold lives in the database, in salesops.operational_config,
# one row each - exactly as the Stage 6 decision thresholds live in
# decision_thresholds. An operator asking "how old is stale?" runs one SELECT,
# and changing a threshold is a visible, timestamped row rather than an edited
# environment variable that only takes effect on the next container restart.
#
#   SELECT config_key, config_value, unit, description
#   FROM salesops.operational_config ORDER BY config_key;
#
# The defaults, all of them OPERATIONAL rather than handed down by any policy:
#
#   staging_retention_days              90    settled staging rows only; 'pending'
#                                             and 'failed' are never deleted
#   stale_run_timeout_minutes          120    longer than the slowest pipeline
#   stale_notification_timeout_minutes 180    longer than the gap between two
#                                             scheduled routing runs
#   stale_remediation_timeout_minutes   60    short: the provider call is bounded
#                                             by an HTTP timeout, so anything
#                                             beyond an hour is a dead process
#   review_warning_age_hours            24    operational ageing, NOT severity
#   review_overdue_age_hours            72
#   review_critical_overdue_age_hours  168
#   max_replay_attempts                  3
#   retry_backoff_minutes               30
#
# An unknown key RAISES rather than returning a plausible default: a typo in a
# threshold name must not quietly disable a safety check.
#
# No secrets are involved anywhere in Stage 10. The maintenance workflow reaches
# the analytics service by name over the Docker network and passes no
# credentials; the one operation that needs a delivery channel (retrying a stale
# notification) is performed by Stage 8, which reads NOTIFICATION_WEBHOOK_URL
# from its own environment as it always has.

# --- Stage 11: the dashboard layer -------------------------------------------
# Three credentials, none of which has a default anywhere in the repository.
#
# METABASE_URL is where the provisioning script finds Metabase from your
# machine. Metabase itself reaches PostgreSQL by container name, so this is the
# only place a host URL appears.
METABASE_URL=http://localhost:3000

# The Metabase login. On a fresh instance the provisioner performs first-time
# setup and creates this user; on an existing one it signs in as this user.
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
METABASE_ADMIN_FIRST_NAME=Sales
METABASE_ADMIN_LAST_NAME=Ops

# Password for the salesops_readonly PostgreSQL role - the ONLY account Metabase
# ever uses. V013 creates that role NOLOGIN and passwordless, because a password
# in a migration is a password in version control; metabase/provision.sh reads
# this value, gives the role a login, and then proves it cannot write by asking
# it to DELETE and requiring the attempt to be refused.
#
# The role has SELECT on the salesops schema and EXECUTE on nothing volatile, so
# the SQL editor in the BI tool is not a write path. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
METABASE_READONLY_DB_PASSWORD=
